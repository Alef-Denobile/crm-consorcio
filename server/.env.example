# Copie este arquivo para ".env" (mesma pasta) e ajuste os valores.

# MongoDB local:
MONGODB_URI=mongodb://127.0.0.1:27017/crm_consorcio

# MongoDB Atlas (nuvem) — exemplo, substitua usuário, senha e cluster:
# MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/crm_consorcio

# Porta em que a API/servidor vai rodar
PORT=3000

# Segredo usado para assinar os tokens de login (JWT).
# Troque por qualquer texto longo e aleatório antes de usar em produção.
JWT_SECRET=troque-este-segredo-por-um-texto-longo-e-aleatorio

# Client ID e Client Secret do Google, usados pelo botão "Continuar com
# Google" e pela sincronização com a Google Agenda.
# Gere em https://console.cloud.google.com/apis/credentials (veja o README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave da API da Anthropic, usada pelos recursos de IA (sugestão de
# mensagem, insights do funil, sugestão de tarefa).
# Gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
